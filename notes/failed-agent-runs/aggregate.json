  "rules": [
    {
      "category": "agent_declared_failure",
      "group": "agent_stopped",
      "pattern": "envelope status=\"(failed|timeout)\"|execution_summary begins with \\'Outcome: failed\\'"
    },
    {
      "category": "no_change_to_ship",
      "group": "nothing_to_change",
      "pattern": "nothing to commit|no staged changes to commit"
    },
    {
      "category": "change_rejected_by_review",
      "group": "change_rejected",
      "pattern": "review_gate_blocked|independent review did not succeed"
    },
    {
      "category": "missing_handoff_summary",
      "group": "agent_process",
      "pattern": "requires a meaningful persisted execution_summary"
    },
    {
      "category": "agent_process_ended",
      "group": "agent_process",
      "pattern": "provider exited|exited with code|wall-clock timeout|agent protocol violation"
    },
    {
      "category": "checkout_changed_during_run",
      "group": "concurrent_work",
      "pattern": "primary_checkout_drift|worktree_integrity_ambiguous|worktree_head_changed"
    },
    {
      "category": "conflict_or_stale_base",
      "group": "concurrent_work",
      "pattern": "conflict|is behind base|must be ahead of and not behind|moved from checkpoint"
    },
    {
      "category": "host_or_repository_setup",
      "group": "machine",
      "pattern": "failed to spawn|Bubblewrap|write-grant anchor|snapshot Git state|squash merge|Squash merges|merge method|auto-merge|TLS handshake|git fetch|git push failed|untracked paths|not permitted by"
    },
    {
      "category": "orbit_defect",
      "group": "machine",
      "pattern": "."
    }
